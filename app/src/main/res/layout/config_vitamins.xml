<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_medium">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reminder_times_label"
        style="@style/TextStyleSubtitle"
        android:layout_marginBottom="@dimen/margin_small" />

    <LinearLayout
        android:id="@+id/containerTimes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="@dimen/margin_medium" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Agregar horario"
        android:layout_marginBottom="@dimen/margin_medium" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchDaily"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/daily_repetition"
        android:checked="true" />

</LinearLayout>

